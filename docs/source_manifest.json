{
  "football-data.org": {
    "role": "current fixtures, kickoff times and results",
    "status": "in use",
    "access": "free API token",
    "limits": "10 requests/minute; LaLiga + Champions League on the free tier",
    "automated": true
  },
  "Football-Data.co.uk": {
    "role": "historical LaLiga results, shots on target and odds",
    "status": "in use",
    "access": "free CSV",
    "limits": "updated Tuesdays and Fridays",
    "automated": true
  },
  "Open-Meteo": {
    "role": "kickoff weather (tooltip context)",
    "status": "in use",
    "access": "free API, non-commercial",
    "limits": "600/min, 5,000/hour, 10,000/day; CC BY 4.0 attribution required",
    "automated": true
  },
  "StatsBomb Open Data": {
    "role": "historical events/lineups",
    "status": "research only",
    "reason": "LaLiga coverage ends 2020/21 and includes only Barcelona matches",
    "automated": false
  },
  "RFEF": {
    "role": "official suspensions",
    "status": "candidate",
    "access": "public decisions/PDFs",
    "automated": "human-reviewed"
  },
  "Understat": {
    "role": "xG",
    "status": "candidate (research only)",
    "reason": "no official API or clear reuse licence",
    "automated": false
  },
  "Transfermarkt": {
    "role": "injuries/market values",
    "status": "not used",
    "reason": "current Terms prohibit bots/screen scraping",
    "automated": false
  },
  "ClubElo": {
    "role": "rating benchmark",
    "status": "not used",
    "reason": "the internal model is reproducible and backtested",
    "automated": false
  }
}
