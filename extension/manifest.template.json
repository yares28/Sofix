{
  "manifest_version": 3,
  "name": "Sofix",
  "version": "0.3.4",
  "description": "Links sorare.com to your Sofix app: your lineups, and your scores drawn on the cards.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://sorare.com/*", "https://www.futbolfantasy.com/partidos/*", "__APP_ORIGIN__/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Sofix",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["https://sorare.com/*"], "js": ["core.js", "bridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://sorare.com/*"], "css": ["overlay.css"], "run_at": "document_start" },
    { "matches": ["https://sorare.com/*"], "js": ["core.js", "content.js", "overlay.js", "drawer.js"], "run_at": "document_idle" }
  ],
  "externally_connectable": {
    "matches": ["__APP_ORIGIN__/*", "http://localhost/*", "http://127.0.0.1/*"]
  }
}
