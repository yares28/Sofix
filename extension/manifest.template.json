{
  "manifest_version": 3,
  "name": "Sofix",
  "version": "0.1.0",
  "description": "Links sorare.com to your Sofix app: your lineups, scores and rewards.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://sorare.com/*", "__APP_ORIGIN__/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Sofix",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["https://sorare.com/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://sorare.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "externally_connectable": { "matches": ["__APP_ORIGIN__/*"] }
}
