# Copy to .env (git-ignored) and fill in. Never commit real values.

# Neon Postgres: pooled host (contains "-pooler") for the app, direct host for migrations.
# Use the postgresql+psycopg:// prefix. Leave both empty to fall back to local SQLite.
POSTGRES_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
POSTGRES_MIGRATION_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Free token from https://www.football-data.org/client/register (10 requests/minute)
FOOTBALL_DATA_ORG_TOKEN=
FOOTBALL_DATA_ORG_COMPETITION=PD
